# Extractor provider: "mock" (default), "openai", or "regex"
EXTRACTOR_PROVIDER=mock

# LLM explanation provider: "mock" (default) or "openai"
LLM_PROVIDER=mock

# Required when EXTRACTOR_PROVIDER=openai or LLM_PROVIDER=openai
OPENAI_API_KEY=your-api-key-here

# Release metadata (safe to expose via GET /version)
APP_VERSION=dev
APP_ENV=development

# Analysis guardrails
ANALYSE_TIMEOUT_SECONDS=30
MAX_INPUT_CHARS=5000

# Set to true to run optional live OpenAI integration tests locally
RUN_LIVE_LLM_TESTS=false
